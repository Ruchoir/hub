{
  "components": {
    "schemas": {
      "Entry": {
        "description": "One entry, as its reader sees it.",
        "properties": {
          "actor": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string"
          },
          "created_at": {
            "description": "RFC 3339.",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "organisation": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "product": {
            "type": "string"
          },
          "read_at": {
            "description": "RFC 3339, when read.",
            "type": [
              "string",
              "null"
            ]
          },
          "variables": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "product",
          "kind",
          "category",
          "object",
          "link",
          "variables",
          "created_at"
        ],
        "type": "object"
      },
      "Health": {
        "description": "Liveness: always `ok` when it answers.",
        "properties": {
          "service": {
            "description": "The service that answers.",
            "example": "hub",
            "type": "string"
          },
          "status": {
            "description": "Always `\"ok\"` when the endpoint responds.",
            "example": "ok",
            "type": "string"
          },
          "version": {
            "description": "The version of the running binary.",
            "example": "0.1.0",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "type": "object"
      },
      "Page": {
        "description": "A page of the inbox.",
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/Entry"
            },
            "type": "array"
          },
          "next_before": {
            "description": "Pass as `before` for the next page; absent on the last.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "unread_count": {
            "description": "What is unread in the whole inbox (of the organisation, when one was asked).",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "entries",
          "unread_count"
        ],
        "type": "object"
      },
      "ProductDescription": {
        "description": "The description of a Ruchoir product or service.",
        "properties": {
          "api": {
            "description": "The API majors served, each under `/api/<major>/`.",
            "example": [
              "v1"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "features": {
            "description": "The features served. A client checks one before relying on it.",
            "example": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "description": "The product's name, as the manifest of the instance lists it.",
            "example": "hub",
            "type": "string"
          },
          "version": {
            "description": "The version of the running build.",
            "example": "0.1.0",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "api",
          "features"
        ],
        "type": "object"
      },
      "Publication": {
        "additionalProperties": false,
        "description": "What a product publishes to the inbox.",
        "properties": {
          "actor": {
            "description": "Who did it, if anyone.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "description": "One of `mention`, `reply`, `direct`, `activity`, `reminder`, `invitation`, `notice`.",
            "type": "string"
          },
          "kind": {
            "description": "`<product>.<name>`, the product being the publisher (`chat.mention`).",
            "type": "string"
          },
          "link": {
            "description": "Where the entry leads: an `https` address of the product.",
            "type": "string"
          },
          "object": {
            "description": "The product's object, an id only the product reads.",
            "type": "string"
          },
          "organisation": {
            "description": "The organisation it happened in, if any.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "recipients": {
            "description": "The accounts it is for, as the product computed them.",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "variables": {
            "additionalProperties": {},
            "description": "What the entry shows, as it stood: names and an excerpt (`{\"place\": \"#général\"}`).",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "kind",
          "category",
          "object",
          "link",
          "recipients"
        ],
        "type": "object"
      },
      "Published": {
        "description": "How many entries a publication made.",
        "properties": {
          "entries": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "entries"
        ],
        "type": "object"
      },
      "Readiness": {
        "description": "Readiness, with what each store answered.",
        "properties": {
          "cache": {
            "description": "Valkey: `\"ok\"` or `\"down\"`.",
            "example": "ok",
            "type": "string"
          },
          "database": {
            "description": "PostgreSQL: `\"ok\"` or `\"down\"`.",
            "example": "ok",
            "type": "string"
          },
          "service": {
            "description": "The service that answers.",
            "example": "hub",
            "type": "string"
          },
          "status": {
            "description": "`\"ok\"` when every store answers, `\"degraded\"` otherwise.",
            "example": "ok",
            "type": "string"
          },
          "version": {
            "description": "The version of the running binary.",
            "example": "0.1.0",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "database",
          "cache"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Notifications and real time for every Ruchoir instance.",
    "license": {
      "identifier": "AGPL-3.0-only",
      "name": "AGPL-3.0-only"
    },
    "title": "Hub API"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/ruchoir-product": {
      "get": {
        "operationId": "describe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDescription"
                }
              }
            },
            "description": "The service's description"
          }
        },
        "summary": "What this service is and what it can do.",
        "tags": [
          "product"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "What each store answered"
          }
        },
        "summary": "Readiness probe: whether PostgreSQL and Valkey answer.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/inbox": {
      "post": {
        "operationId": "publish",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Publication"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Published"
                }
              }
            },
            "description": "Stored, one entry per recipient"
          },
          "400": {
            "description": "Refused (`reason`: `kind`, `kind_not_yours`, `category`, `object`, `link`, `variables`, `recipients`)"
          },
          "401": {
            "description": "No valid token"
          },
          "403": {
            "description": "Not a product with `hub:publish`"
          }
        },
        "summary": "Publish entries to the inbox.",
        "tags": [
          "inbox"
        ]
      }
    },
    "/api/v1/me/inbox": {
      "get": {
        "operationId": "read",
        "parameters": [
          {
            "description": "Only what is unread.",
            "in": "query",
            "name": "unread",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Page size, at most 100.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "Entries older than this one (keyset pagination).",
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Only this organisation's entries.",
            "in": "query",
            "name": "organisation",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            },
            "description": "A page of the inbox"
          },
          "401": {
            "description": "No valid token"
          },
          "403": {
            "description": "Not a person's token"
          }
        },
        "summary": "The person's inbox, newest first, with what is unread.",
        "tags": [
          "inbox"
        ]
      }
    },
    "/api/v1/me/inbox/read": {
      "post": {
        "operationId": "mark_all_read",
        "parameters": [
          {
            "description": "Only this organisation's.",
            "in": "query",
            "name": "organisation",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": "All read"
          }
        },
        "summary": "Mark every entry read (of one organisation, when asked). Idempotent.",
        "tags": [
          "inbox"
        ]
      }
    },
    "/api/v1/me/inbox/{id}/read": {
      "post": {
        "operationId": "mark_read",
        "parameters": [
          {
            "description": "The entry",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Read"
          },
          "404": {
            "description": "No such entry of the reader's"
          }
        },
        "summary": "Mark one entry read. Idempotent; another person's entry is not found.",
        "tags": [
          "inbox"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The process is up"
          }
        },
        "summary": "Liveness probe, for the container runtime and the reverse proxy.",
        "tags": [
          "health"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Probes for the container runtime, the proxy and the installer",
      "name": "health"
    },
    {
      "description": "What the service is and what it can do",
      "name": "product"
    },
    {
      "description": "What a person was told about, published by the products",
      "name": "inbox"
    }
  ]
}
