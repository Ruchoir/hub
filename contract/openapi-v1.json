{
  "components": {
    "schemas": {
      "Categories": {
        "description": "Which categories reach someone through one channel.",
        "properties": {
          "activity": {
            "default": true,
            "type": "boolean"
          },
          "direct": {
            "default": true,
            "type": "boolean"
          },
          "invitation": {
            "default": true,
            "type": "boolean"
          },
          "mention": {
            "default": true,
            "type": "boolean"
          },
          "notice": {
            "default": true,
            "type": "boolean"
          },
          "reminder": {
            "default": true,
            "type": "boolean"
          },
          "reply": {
            "default": true,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "Choice": {
        "description": "A presence to choose.",
        "properties": {
          "choice": {
            "description": "`active`, `away`, `dnd`, `invisible`, or `null` for automatic.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Entry": {
        "description": "One entry, as its reader sees it.",
        "properties": {
          "actor": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": "string"
          },
          "created_at": {
            "description": "RFC 3339.",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "organisation": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "product": {
            "type": "string"
          },
          "read_at": {
            "description": "RFC 3339, when read.",
            "type": [
              "string",
              "null"
            ]
          },
          "variables": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "product",
          "kind",
          "category",
          "object",
          "link",
          "variables",
          "created_at"
        ],
        "type": "object"
      },
      "Health": {
        "description": "Liveness: always `ok` when it answers.",
        "properties": {
          "service": {
            "description": "The service that answers.",
            "example": "hub",
            "type": "string"
          },
          "status": {
            "description": "Always `\"ok\"` when the endpoint responds.",
            "example": "ok",
            "type": "string"
          },
          "version": {
            "description": "The version of the running binary.",
            "example": "0.1.0",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "type": "object"
      },
      "Level": {
        "description": "A level for one organisation.",
        "properties": {
          "level": {
            "description": "`all`, `mentions`, `none`, or `null` to go back to `all`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "MemberPresence": {
        "description": "One member's presence.",
        "properties": {
          "account": {
            "format": "uuid",
            "type": "string"
          },
          "presence": {
            "description": "`active`, `away`, `dnd` or `offline`.",
            "type": "string"
          }
        },
        "required": [
          "account",
          "presence"
        ],
        "type": "object"
      },
      "MyPresence": {
        "description": "The person's own presence, as they see it.",
        "properties": {
          "choice": {
            "description": "What they chose, or `null` for automatic.",
            "type": [
              "string",
              "null"
            ]
          },
          "presence": {
            "description": "How it reads to them (`invisible` stays visible to its author).",
            "type": "string"
          }
        },
        "required": [
          "presence"
        ],
        "type": "object"
      },
      "NotificationPrefs": {
        "description": "A person's own notification settings.\n\nEvery field has a default, and a stored document missing a field (written before it existed)\ntakes that default rather than failing to load.",
        "properties": {
          "app": {
            "default": {
              "activity": true,
              "direct": true,
              "invitation": true,
              "mention": true,
              "notice": true,
              "reminder": true,
              "reply": true
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/Categories",
                "description": "What reaches them in the app and by push."
              }
            ]
          },
          "email": {
            "default": true,
            "description": "The mail fallback's master switch, then what reaches them by mail.",
            "type": "boolean"
          },
          "email_categories": {
            "default": {
              "activity": false,
              "direct": true,
              "invitation": true,
              "mention": true,
              "notice": true,
              "reminder": true,
              "reply": true
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/Categories"
              }
            ]
          },
          "enabled": {
            "default": true,
            "description": "Master switch: off, nothing notifies, anywhere.",
            "type": "boolean"
          },
          "quiet_from": {
            "default": "21:00",
            "description": "Start of the quiet window, `HH:MM`, local time; may be later than `quiet_to` (overnight).",
            "type": "string"
          },
          "quiet_hours": {
            "default": false,
            "description": "Hold notifications back during the window below.",
            "type": "boolean"
          },
          "quiet_to": {
            "default": "08:00",
            "description": "End of the quiet window, `HH:MM`, local time.",
            "type": "string"
          },
          "sound": {
            "default": true,
            "description": "Play a sound with a notification.",
            "type": "boolean"
          },
          "utc_offset_minutes": {
            "default": 0,
            "description": "Offset of the person's clock from UTC, in minutes (`+120` in Paris in summer).",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "Page": {
        "description": "A page of the inbox.",
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/components/schemas/Entry"
            },
            "type": "array"
          },
          "next_before": {
            "description": "Pass as `before` for the next page; absent on the last.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "unread_count": {
            "description": "What is unread in the whole inbox (of the organisation, when one was asked).",
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "entries",
          "unread_count"
        ],
        "type": "object"
      },
      "ProductDescription": {
        "description": "The description of a Ruchoir product or service.",
        "properties": {
          "api": {
            "description": "The API majors served, each under `/api/<major>/`.",
            "example": [
              "v1"
            ],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "features": {
            "description": "The features served. A client checks one before relying on it.",
            "example": [],
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "description": "The product's name, as the manifest of the instance lists it.",
            "example": "hub",
            "type": "string"
          },
          "version": {
            "description": "The version of the running build.",
            "example": "0.1.0",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "api",
          "features"
        ],
        "type": "object"
      },
      "Publication": {
        "additionalProperties": false,
        "description": "What a product publishes to the inbox.",
        "properties": {
          "actor": {
            "description": "Who did it, if anyone.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "description": "One of `mention`, `reply`, `direct`, `activity`, `reminder`, `invitation`, `notice`.",
            "type": "string"
          },
          "kind": {
            "description": "`<product>.<name>`, the product being the publisher (`chat.mention`).",
            "type": "string"
          },
          "link": {
            "description": "Where the entry leads: an `https` address of the product.",
            "type": "string"
          },
          "object": {
            "description": "The product's object, an id only the product reads.",
            "type": "string"
          },
          "organisation": {
            "description": "The organisation it happened in, if any.",
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "recipients": {
            "description": "The accounts it is for, as the product computed them.",
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "variables": {
            "additionalProperties": {},
            "description": "What the entry shows, as it stood: names and an excerpt (`{\"place\": \"#général\"}`).",
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "required": [
          "kind",
          "category",
          "object",
          "link",
          "recipients"
        ],
        "type": "object"
      },
      "Published": {
        "description": "How many entries a publication made.",
        "properties": {
          "entries": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "entries"
        ],
        "type": "object"
      },
      "Readiness": {
        "description": "Readiness, with what each store answered.",
        "properties": {
          "cache": {
            "description": "Valkey: `\"ok\"` or `\"down\"`.",
            "example": "ok",
            "type": "string"
          },
          "database": {
            "description": "PostgreSQL: `\"ok\"` or `\"down\"`.",
            "example": "ok",
            "type": "string"
          },
          "service": {
            "description": "The service that answers.",
            "example": "hub",
            "type": "string"
          },
          "status": {
            "description": "`\"ok\"` when every store answers, `\"degraded\"` otherwise.",
            "example": "ok",
            "type": "string"
          },
          "version": {
            "description": "The version of the running binary.",
            "example": "0.1.0",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "database",
          "cache"
        ],
        "type": "object"
      },
      "Ticket": {
        "description": "A new ticket.",
        "properties": {
          "expires_in": {
            "description": "Seconds it waits.",
            "format": "int64",
            "type": "integer"
          },
          "ticket": {
            "type": "string"
          }
        },
        "required": [
          "ticket",
          "expires_in"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Notifications and real time for every Ruchoir instance.",
    "license": {
      "identifier": "AGPL-3.0-only",
      "name": "AGPL-3.0-only"
    },
    "title": "Hub API"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/ruchoir-product": {
      "get": {
        "operationId": "describe",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductDescription"
                }
              }
            },
            "description": "The service's description"
          }
        },
        "summary": "What this service is and what it can do.",
        "tags": [
          "product"
        ]
      }
    },
    "/api/v1/backchannel-logout": {
      "post": {
        "operationId": "backchannel_logout",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "string"
              }
            }
          },
          "description": "`logout_token`",
          "required": true
        },
        "responses": {
          "200": {
            "description": "Done"
          },
          "400": {
            "description": "No logout token, or one that does not hold"
          }
        },
        "summary": "Propolis's back-channel logout (OpenID Connect Back-Channel Logout 1.0): a session ended, so the\nsockets it opened close, on every process; with no `sid`, every socket of the person.",
        "tags": [
          "live"
        ]
      }
    },
    "/api/v1/events": {
      "post": {
        "operationId": "intake",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "A ruchoir-events Event, signed in the Ruchoir-Signature header",
          "required": true
        },
        "responses": {
          "202": {
            "description": "Stored for every subscriber"
          },
          "400": {
            "description": "Refused (`reason`: `signature`, `source`, `kind_not_yours`, `too_large`)"
          },
          "401": {
            "description": "No valid token"
          },
          "403": {
            "description": "Not a product with `hub:publish`"
          }
        },
        "summary": "Take an event from its emitter.",
        "tags": [
          "events"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "What each store answered"
          }
        },
        "summary": "Readiness probe: whether PostgreSQL and Valkey answer.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/inbox": {
      "post": {
        "operationId": "publish",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Publication"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Published"
                }
              }
            },
            "description": "Stored, one entry per recipient"
          },
          "400": {
            "description": "Refused (`reason`: `kind`, `kind_not_yours`, `category`, `object`, `link`, `variables`, `recipients`)"
          },
          "401": {
            "description": "No valid token"
          },
          "403": {
            "description": "Not a product with `hub:publish`"
          }
        },
        "summary": "Publish entries to the inbox.",
        "tags": [
          "inbox"
        ]
      }
    },
    "/api/v1/live/publish": {
      "post": {
        "operationId": "publish",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "A `Publication` of ruchoir-events: `audience` and `frame`",
          "required": true
        },
        "responses": {
          "202": {
            "description": "Handed to every process"
          },
          "400": {
            "description": "Refused (`reason`: `frame_type_not_yours`, `audience`)"
          },
          "401": {
            "description": "No valid token"
          },
          "403": {
            "description": "Not a product with `hub:publish`"
          }
        },
        "summary": "Push a frame to the audience a product computed.",
        "tags": [
          "live"
        ]
      }
    },
    "/api/v1/live/sse": {
      "get": {
        "operationId": "open",
        "parameters": [
          {
            "description": "A page's single-use ticket.",
            "in": "query",
            "name": "ticket",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A stream of frames"
          },
          "401": {
            "description": "No ticket or token, or not a valid one"
          },
          "403": {
            "description": "A page origin the instance does not serve"
          }
        },
        "summary": "Open the stream.",
        "tags": [
          "live"
        ]
      }
    },
    "/api/v1/live/tickets": {
      "post": {
        "operationId": "issue",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            },
            "description": "A single-use ticket, a minute long"
          },
          "401": {
            "description": "No valid token"
          },
          "403": {
            "description": "Not a token a product exchanged for a person"
          }
        },
        "summary": "Get a page's product a ticket for the person it acts for.",
        "tags": [
          "live"
        ]
      }
    },
    "/api/v1/live/ws": {
      "get": {
        "operationId": "open",
        "parameters": [
          {
            "description": "A page's single-use ticket.",
            "in": "query",
            "name": "ticket",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switching to WebSocket"
          },
          "401": {
            "description": "No ticket or token, or not a valid one"
          },
          "403": {
            "description": "A page origin the instance does not serve"
          }
        },
        "summary": "Open the socket.",
        "tags": [
          "live"
        ]
      }
    },
    "/api/v1/me/inbox": {
      "get": {
        "operationId": "read",
        "parameters": [
          {
            "description": "Only what is unread.",
            "in": "query",
            "name": "unread",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "Page size, at most 100.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "description": "Entries older than this one (keyset pagination).",
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Only this organisation's entries.",
            "in": "query",
            "name": "organisation",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            },
            "description": "A page of the inbox"
          },
          "401": {
            "description": "No valid token"
          },
          "403": {
            "description": "Not a person's token"
          }
        },
        "summary": "The person's inbox, newest first, with what is unread.",
        "tags": [
          "inbox"
        ]
      }
    },
    "/api/v1/me/inbox/read": {
      "post": {
        "operationId": "mark_all_read",
        "parameters": [
          {
            "description": "Only this organisation's.",
            "in": "query",
            "name": "organisation",
            "required": false,
            "schema": {
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": "All read"
          }
        },
        "summary": "Mark every entry read (of one organisation, when asked). Idempotent.",
        "tags": [
          "inbox"
        ]
      }
    },
    "/api/v1/me/inbox/{id}/read": {
      "post": {
        "operationId": "mark_read",
        "parameters": [
          {
            "description": "The entry",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Read"
          },
          "404": {
            "description": "No such entry of the reader's"
          }
        },
        "summary": "Mark one entry read. Idempotent; another person's entry is not found.",
        "tags": [
          "inbox"
        ]
      }
    },
    "/api/v1/me/notification-preferences": {
      "get": {
        "operationId": "read",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPrefs"
                }
              }
            },
            "description": "The settings, with the defaults for what was never saved"
          }
        },
        "summary": "Read one's own notification settings.",
        "tags": [
          "preferences"
        ]
      },
      "put": {
        "operationId": "save",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationPrefs"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Saved"
          },
          "400": {
            "description": "Not settings the hub can act on (`reason`: `quiet_hours`, `utc_offset`)"
          }
        },
        "summary": "Save one's own notification settings, whole.",
        "tags": [
          "preferences"
        ]
      }
    },
    "/api/v1/me/organisations/{id}/notification-level": {
      "put": {
        "operationId": "set_level",
        "parameters": [
          {
            "description": "The organisation",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Level"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Set"
          },
          "400": {
            "description": "Not a level"
          },
          "404": {
            "description": "Not one of the person's organisations"
          }
        },
        "summary": "Set how much one organisation notifies the person.",
        "tags": [
          "preferences"
        ]
      }
    },
    "/api/v1/me/presence": {
      "get": {
        "operationId": "mine",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyPresence"
                }
              }
            },
            "description": "The person's presence"
          }
        },
        "summary": "Read one's own presence.",
        "tags": [
          "live"
        ]
      },
      "put": {
        "operationId": "choose",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Choice"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Chosen"
          },
          "400": {
            "description": "Not a presence one may choose"
          }
        },
        "summary": "Choose one's presence; everyone who shares an organisation sees the change.",
        "tags": [
          "live"
        ]
      }
    },
